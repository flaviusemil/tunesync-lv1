#include <winver.h>
#include "version.h"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION TR_VERSION_MAJOR,TR_VERSION_MINOR,TR_VERSION_PATCH,0
 PRODUCTVERSION TR_VERSION_MAJOR,TR_VERSION_MINOR,TR_VERSION_PATCH,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Orion Technologies"
      VALUE "FileDescription", "Tune Remote - MIDI sets the key of every Waves Tune Real-Time in eMotion LV1"
      VALUE "FileVersion", TR_VERSION_STR
      VALUE "InternalName", "TuneRemote_Control"
      VALUE "OriginalFilename", "TuneRemote_Control.dll"
      VALUE "ProductName", TR_PRODUCT
      VALUE "ProductVersion", TR_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
